{
  "name": "angelsrest",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.34.5"
  },
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "lint": "biome check . && eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test",
    "security:audit": "corepack pnpm@11.4.0 --pm-on-fail=ignore audit --audit-level low",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && sanity build && corepack pnpm run security:audit",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@jessepomeroy/print-catalog": "^0.2.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/orderable-document-list": "^1.5.1",
    "@sanity/presentation": "^2.0.0",
    "@sanity/ui": "^3.1.14",
    "@sanity/vision": "^5.31.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sanity": "^5.31.1",
    "sanity-plugin-documents-pane": "^3.0.2",
    "sanity-plugin-media": "^4.2.0",
    "styled-components": "^6.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  }
}
